# ───────── Serveur ─────────
NODE_ENV=production
PORT=5000

# Origines autorisées (séparées par des virgules) ou *
CORS_ORIGINS=*

# ───────── API Laravel ─────────
# URL de base de l'API (avec /api)
LARAVEL_API_URL=https://api.rudless.com/api

# Clé partagée avec Laravel pour /count-* (OBLIGATOIRE en production)
# (ancien nom NODE_NOTIFY_KEY toujours accepté)
SOCKET_NOTIFY_KEY=change-me

# ───────── Push Expo ─────────
# Exiger la clé (?key= ou en-tête x-notify-key) sur /send-push (false tant que Laravel n'envoie pas la clé)
PUSH_REQUIRE_KEY=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ───────── Médias ─────────
UPLOAD_DIR=uploads
# Windows : C:\ffmpeg\bin\ffmpeg.exe — Linux : laisser vide si ffmpeg est dans le PATH
FFMPEG_PATH=
MAX_UPLOAD_MB=50

# ───────── Appels / Rooms / Lives ─────────
CALL_RING_TIMEOUT_MS=45000
ROOM_MAX_PARTICIPANTS=10
ROOM_CLEANUP_DELAY_MS=1800000
